# Vorlage für die Umgebungsvariablen. Als `.env` kopieren und ausfüllen.
# `.env` steht in .gitignore – echte Werte gehören niemals ins Repository.

# ---------------------------------------------------------------------------
# Datenbank (PostgreSQL)
# ---------------------------------------------------------------------------
# Ohne DATABASE_URL läuft der Server mit einem flüchtigen In-Memory-Speicher:
# Impostor ist damit voll spielbar, Wer-bin-ich-Räume überleben aber keinen
# Neustart. In Produktion wird der Start ohne DATABASE_URL abgelehnt.
DATABASE_URL=postgres://benutzer:passwort@host:5432/datenbank

# TLS wird bei Neon, Supabase und Vercel Postgres automatisch erkannt.
# Für eine lokale Instanz ohne TLS: DATABASE_SSL=disable
# DATABASE_SSL=disable

# Erzwingt einen Speicher-Adapter (postgres | memory). Normalerweise nicht nötig.
# ROOM_STORE=postgres

# ---------------------------------------------------------------------------
# Admin-Zugang (/admin)
# ---------------------------------------------------------------------------
# Es gibt keine öffentliche Registrierung. Den Hash erzeugt `npm run admin:hash`;
# das Klartextpasswort wird nirgends gespeichert.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Pfeffer für pseudonyme Hashes (Gerät, IP) und Sitzungen.
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Öffentliche Basis-URL
# ---------------------------------------------------------------------------
# Grundlage für Deep Links und QR-Codes. Ohne Angabe wird window.location.origin
# verwendet, was lokal und im Preview-Deployment in der Regel ausreicht.
# VITE_PUBLIC_BASE_URL=https://komm10te-amar-v1.vercel.app
# PUBLIC_BASE_URL=https://komm10te-amar-v1.vercel.app
