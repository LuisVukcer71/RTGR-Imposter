// TSConfig for the serverless API layer, the shared domain code it consumes and the CLI scripts.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*", "api/**/*", "scripts/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  }
}
