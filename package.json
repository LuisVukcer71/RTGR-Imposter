{
  "name": "imposter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "db:rollback": "tsx scripts/migrate.ts --down",
    "db:seed": "tsx scripts/seed.ts",
    "admin:hash": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "^1.5.6",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "tsx": "^4.23.9",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
